# Copia este archivo a .env y ajusta valores. Nunca confirmes .env al repositorio.

# --- Base de datos operacional (fuente de verdad) ---
DATABASE_URL=postgresql+psycopg://kipu:kipu@localhost:5433/kipu

# --- Almacenamiento de artefactos (evidencia inmutable) ---
# fs = filesystem local direccionado por contenido; minio = S3-compatible
ARTIFACT_STORE=fs
ARTIFACT_FS_ROOT=var/artifacts

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=kipu
MINIO_SECRET_KEY=kipu-secret-change-me
MINIO_BUCKET=kipu-artifacts
MINIO_SECURE=false

# --- Política de fuente viva ---
# Las capturas en vivo están deshabilitadas por defecto (CI y desarrollo local).
LIVE_SOURCE_ENABLED=false
CRAWLER_USER_AGENT=KipuKnowledge/0.1 (+contacto: configurar-email-real)
CRAWLER_RATE_LIMIT_SECONDS=2.0
CRAWLER_MAX_RETRIES=3
# Tope del recorrido del índice diario (20 dispositivos por página). No es una
# cuota de resultados: si se alcanza, el descubrimiento falla en vez de truncar.
CRAWLER_MAX_LISTING_PAGES=25

# --- LLM opcional (desactivado por defecto; el MVP no lo requiere) ---
LLM_EXTRACTOR_ENABLED=false
LLM_PROVIDER=
LLM_MODEL=
