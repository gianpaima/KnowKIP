{
  "@context": {
    "kipu": "https://kipu.example/ontology#",
    "eli": "http://data.europa.eu/eli/ontology#",
    "prov": "http://www.w3.org/ns/prov#",
    "org": "http://www.w3.org/ns/org#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "dcterms": "http://purl.org/dc/terms/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "LegalDocument": "kipu:LegalDocument",
    "PersonnelEvent": "kipu:PersonnelEvent",
    "RoleAssignment": "kipu:RoleAssignment",
    "Person": "kipu:Person",
    "PersonMention": "kipu:PersonMention",
    "Organization": "kipu:Organization",
    "OrganizationalUnit": "kipu:OrganizationalUnit",
    "Position": "kipu:Position",
    "PositionSlot": "kipu:PositionSlot",
    "Mandate": "kipu:Mandate",
    "EvidenceSpan": "kipu:EvidenceSpan",
    "ArtifactVersion": "kipu:ArtifactVersion",
    "ExtractionRun": "kipu:ExtractionRun",
    "Assertion": "kipu:Assertion",

    "publicationCode": "kipu:publicationCode",
    "documentNumber": "kipu:documentNumber",
    "documentNumberRaw": "kipu:documentNumberRaw",
    "title": "dcterms:title",
    "issuedOn": {"@id": "kipu:issuedOn", "@type": "xsd:date"},
    "publishedOn": {"@id": "kipu:publishedOn", "@type": "xsd:date"},
    "issuePlaceRaw": "kipu:issuePlaceRaw",
    "declaredBy": {"@id": "kipu:declaredBy", "@type": "@id"},
    "eventType": {"@id": "kipu:eventType", "@type": "@id"},
    "assignmentEffect": "kipu:assignmentEffect",
    "legalVerbRaw": "kipu:legalVerbRaw",
    "effectiveFrom": {"@id": "kipu:effectiveFrom", "@type": "xsd:date"},
    "effectiveFromStatus": "kipu:effectiveFromStatus",
    "effectiveTo": {"@id": "kipu:effectiveTo", "@type": "xsd:date"},
    "effectiveToStatus": "kipu:effectiveToStatus",
    "endConditionText": "kipu:endConditionText",
    "hasParticipant": {"@id": "kipu:hasParticipant", "@type": "@id"},
    "startsAssignment": {"@id": "kipu:startsAssignment", "@type": "@id"},
    "endsAssignment": {"@id": "kipu:endsAssignment", "@type": "@id"},
    "affectedAssignmentUnresolved": {"@id": "kipu:affectedAssignmentUnresolved", "@type": "xsd:boolean"},
    "assignmentOf": {"@id": "kipu:assignmentOf", "@type": "@id"},
    "assignmentMention": {"@id": "kipu:assignmentMention", "@type": "@id"},
    "assignmentPosition": {"@id": "kipu:assignmentPosition", "@type": "@id"},
    "assignmentKind": "kipu:assignmentKind",
    "positionLabelRaw": "kipu:positionLabelRaw",
    "isCollective": {"@id": "kipu:isCollective", "@type": "xsd:boolean"},
    "underMandate": {"@id": "kipu:underMandate", "@type": "@id"},
    "mandateType": "kipu:mandateType",
    "mentionText": "kipu:mentionText",
    "mentionTextNormalized": "kipu:mentionTextNormalized",
    "resolvesTo": {"@id": "kipu:resolvesTo", "@type": "@id"},
    "resolutionStatus": "kipu:resolutionStatus",
    "preferredName": "kipu:preferredName",
    "positionLabel": "kipu:positionLabel",
    "positionIn": {"@id": "kipu:positionIn", "@type": "@id"},
    "positionUnit": {"@id": "kipu:positionUnit", "@type": "@id"},
    "hasSlot": {"@id": "kipu:hasSlot", "@type": "@id"},
    "externalScheme": "kipu:externalScheme",
    "externalCode": "kipu:externalCode",
    "unitOf": {"@id": "kipu:unitOf", "@type": "@id"},
    "parentUnit": {"@id": "kipu:parentUnit", "@type": "@id"},
    "sha256": "kipu:sha256",
    "capturedAt": {"@id": "kipu:capturedAt", "@type": "xsd:dateTime"},
    "quotedText": "kipu:quotedText",
    "quotedTextSha256": "kipu:quotedTextSha256",
    "inArtifactVersion": {"@id": "kipu:inArtifactVersion", "@type": "@id"},
    "articleLabel": "kipu:articleLabel",
    "evidence": {"@id": "kipu:evidence", "@type": "@id"},
    "confidence": {"@id": "kipu:confidence", "@type": "xsd:decimal"},
    "reviewStatus": "kipu:reviewStatus",
    "wasExtractedBy": {"@id": "kipu:wasExtractedBy", "@type": "@id"},
    "parserVersion": "kipu:parserVersion",
    "extractorVersion": "kipu:extractorVersion",
    "ontologyVersion": "kipu:ontologyVersion",
    "references": {"@id": "kipu:references", "@type": "@id"}
  }
}
